[
  {
    "label": "Resterm: Run request",
    "command": "printf '%s' \"$RESTERM_SOURCE\" | resterm run --line \"$RESTERM_LINE\" -",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "save": "none",
    "tags": [
      "resterm-request"
    ],
    "env": {
      "RESTERM_SOURCE": "$ZED_CUSTOM_source",
      "RESTERM_LINE": "$ZED_ROW"
    }
  },
  {
    "label": "Resterm: Run all requests",
    "command": "resterm",
    "args": [
      "run",
      "--all",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": false,
    "show_command": false,
    "save": "current"
  }
]
