[
  {
    "label": "Resterm: Run request",
    "command": "resterm",
    "args": ["run", "--line", "$ZED_ROW", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current",
    "tags": ["resterm-request"]
  },
  {
    "label": "Resterm: Run all requests",
    "command": "resterm",
    "args": ["run", "--all", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "current"
  }
]
